{
  "name": "easy-svg-panel",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "The Icons admin panel for Easy SVG. Chakra UI v3 on the UnleashWP design system; the bundle loads only on the Icons panel screen. Pro extends it through window.EasySvgPanel.",
  "scripts": {
    "build": "vite build --mode ui && vite build && vite build --mode hint",
    "dev": "vite build --watch",
    "lint": "eslint src",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.38.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/modifiers": "9.0.0",
    "@dnd-kit/sortable": "10.0.0",
    "@emotion/react": "^11.14.0",
    "dompurify": "^3.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "5.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "^1.65.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@wordpress/env": "^12.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "vite": "^6.4.6"
  },
  "overrides": {
    "express": {
      "qs": "~6.16.1"
    },
    "@wordpress/env": {
      "rimraf": "^6.1.4",
      "isomorphic-git": "^1.38.6"
    }
  }
}
